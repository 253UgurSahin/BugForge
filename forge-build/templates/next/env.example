# Copy this file to .env and fill it in. .env holds the real secrets: it is never committed
# and never copied into an image. Make passwords and keys with: openssl rand -hex 24
# The values below are safe production defaults. Development values are in the comments.
# Server-side settings only. NEXT_PUBLIC_ values are baked in at build time: they go in
# .env.production, which every visitor can read, so never a secret.

# PostgreSQL. docker-compose.yml builds DATABASE_URL from these, so use letters and digits only.
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me

# Better Auth. The URL is the address people type, with https:// once the app is behind your proxy.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:8080

# The port on this machine (127.0.0.1 only) where docker-compose.yml publishes the app.
# Change BETTER_AUTH_URL with it.
APP_PORT=8080

# Your SMTP server. Development: SMTP_HOST=mailpit, SMTP_PORT=1025, empty user and password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hello@example.com

# Stripe in test mode. Live keys are your own step, outside forge.
# Delete these lines if the app takes no payments.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Development only: also start mailpit, which catches every email. Its inbox is on
# http://localhost:8025, or the port in MAILPIT_PORT.
# COMPOSE_PROFILES=dev
# MAILPIT_PORT=8025

# Development and tests only: the password of the fake users the seed script makes.
SEED_PASSWORD=change-me
