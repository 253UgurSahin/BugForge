# Copy this file to .env and fill it in. .env holds the real secrets: it is never committed
# and never copied into an image. Make passwords and keys with: openssl rand -hex 24
# The values below are safe production defaults. Development values are in the comments.

DJANGO_SECRET_KEY=change-me
# Development: DJANGO_DEBUG=true
DJANGO_DEBUG=false
# Keep localhost: the health check uses it. Add your own domain, for example localhost,app.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The address people type, with https:// once the app is behind your reverse proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# PostgreSQL. MariaDB instead: DB_ENGINE=django.db.backends.mysql and DB_PORT=3306.
DB_ENGINE=django.db.backends.postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me

# Your SMTP server. Development: SMTP_HOST=mailpit, SMTP_PORT=1025, empty user and password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hello@example.com

# Stripe in test mode. Live keys are your own step, outside forge.
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Development only: also start mailpit, which catches every email.
# COMPOSE_PROFILES=dev
