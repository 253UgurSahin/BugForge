# Copy this file to .env and fill it in. .env holds the real secrets: it is never committed
# and never copied into an image. Make passwords and keys with: openssl rand -hex 24
# The values below are safe production defaults. Development values are in the comments.

APP_NAME="My App"
APP_ENV=production
# Make one with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
# Development: APP_ENV=local and APP_DEBUG=true

# Logs go to `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-me

SESSION_DRIVER=database
# Cookies only over HTTPS. Development over plain http: SESSION_SECURE_COOKIE=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Your SMTP server. Development: MAIL_HOST=mailpit, MAIL_PORT=1025, empty username and password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe in test mode. Live keys are your own step, outside forge.
STRIPE_KEY=pk_test_change_me
STRIPE_SECRET=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Development only: also start mailpit, which catches every email.
# COMPOSE_PROFILES=dev
