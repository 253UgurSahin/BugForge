{
  "_about": "Themes reviews.py sorts reviews into. Patterns are Python regular expressions, matched without regard to case against the review text, in English and Dutch. kind is complaint (something users hate) or request (something users want that is missing). request_patterns find wishes in any review, whatever its theme. A curly apostrophe in a review reads as a straight one, and a 5-star review counts toward no theme. To add a category's own words (a booking app: double booking, time zone, no-show), copy this file to a scratch folder outside the project, edit the copy and pass it with --themes. Never edit this file for one project.",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\b(it|app|this|really|still|just|badly|desperately|seriously) needs? (a|an|the|to|more|better)\\b",
    "\\b(i|we) need (a way|an option|the option|the ability)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
    "(?<!nothing )(?<!nothing is )(?<!nothing's )(?<!not )\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bik mis\\b",
    "(?<!niets )(?<!niks )\\bontbreekt\\b(?! (er )?(niets|niks))",
    "\\bzou (fijn|handig|mooi|top|prettig) zijn\\b",
    "\\bzou graag\\b",
    "\\b(er )?is geen (optie|manier|mogelijkheid)\\b",
    "\\bhelaas geen\\b"
  ],
  "themes": [
    {"id": "pricing", "label": "Price and paywalls", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\boverpriced\\b", "\\bpric(e|es|ey|ing)\\b", "\\bpaywall", "\\bsubscription\\b", "\\bper (month|seat|user)\\b", "\\bfree (plan|tier|version)\\b", "\\bupgrade to\\b", "\\bpremium\\b", "\\bnot worth\\b", "\\bcost(s|ly)?\\b",
                  "\\bte duur\\b", "\\bprijzig\\b", "\\bprijs\\b", "\\bprijzen\\b", "\\babonnement", "\\bgratis versie\\b", "\\bniet waard\\b"]},
    {"id": "billing", "label": "Billing, cancelling and refunds", "kind": "complaint",
     "patterns": ["\\bcharged\\b", "\\brefund", "\\bcancel(l?ing|l?ed|lation)?\\b", "\\bauto.?renew", "\\bhidden (fee|charge)", "\\bbilling\\b", "\\bscam\\b", "\\bcredit card\\b",
                  "\\bopzeggen\\b", "\\bopgezegd\\b", "\\bgeld terug\\b", "\\bterugbetal", "\\bafgeschreven\\b", "\\boplichting\\b", "\\bincasso\\b"]},
    {"id": "bugs", "label": "Bugs and crashes", "kind": "complaint",
     "patterns": ["\\bcrash(es|ed|ing)?\\b", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez(e|es|ing)\\b", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\berror\\b",
                  "\\bwerkt niet\\b", "\\bcrasht\\b", "\\bloopt vast\\b", "\\bfoutmelding", "\\bkapot\\b"]},
    {"id": "performance", "label": "Slow, laggy, heavy", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\blag(gy|s)?\\b", "\\bloading\\b", "\\btakes forever\\b", "\\bbattery\\b", "\\bsluggish\\b", "\\bheavy\\b",
                  "\\btraag\\b", "\\bduurt (erg |heel |veel te |te )?lang\\b"]},
    {"id": "data", "label": "Sync and lost data", "kind": "complaint",
     "patterns": ["\\bsync(ing|s|ed)?\\b", "\\blost (my|all)\\b", "\\bdisappear", "\\bdata loss\\b", "\\bwiped\\b", "\\bbackup\\b", "\\bduplicat",
                  "\\bkwijt\\b", "\\bverdwenen\\b", "\\bsynchronis"]},
    {"id": "ux", "label": "Confusing or clunky to use", "kind": "complaint",
     "patterns": ["\\bconfus", "\\bhard to (use|find|navigate|understand)\\b", "\\bcomplicated\\b", "\\bcluttered\\b", "\\bunintuitive\\b", "\\bnot intuitive\\b", "\\bclunky\\b", "\\btoo many (steps|clicks|taps)\\b", "\\blearning curve\\b", "\\bcan'?t find\\b",
                  "\\bonduidelijk\\b", "\\bingewikkeld\\b", "\\bonoverzichtelijk\\b", "\\bomslachtig\\b", "\\bniet te vinden\\b"]},
    {"id": "support", "label": "Support that does not answer", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bsupport (team|is|was)\\b", "\\bno (response|reply)\\b", "\\bnever (replied|responded|heard back)\\b", "\\bticket\\b", "\\bchat ?bot\\b",
                  "\\bklantenservice\\b", "\\bhelpdesk\\b", "\\bgeen (antwoord|reactie)\\b"]},
    {"id": "account", "label": "Login and account problems", "kind": "complaint",
     "patterns": ["\\blog ?in\\b", "\\bsign ?in\\b", "\\bpassword\\b", "\\blocked out\\b", "\\bverification\\b", "\\b2fa\\b", "\\bdelete (my )?account\\b",
                  "\\binloggen\\b", "\\bwachtwoord\\b", "\\baccount verwijderen\\b"]},
    {"id": "notifications", "label": "Notifications and spam", "kind": "complaint",
     "patterns": ["\\btoo many (notifications|reminders|e-?mails|messages|pings|pop.?ups)\\b", "\\bspam", "\\bnotifications? (spam|overload)\\b", "\\b(constant|endless|annoying|non-?stop) (notifications|reminders|e-?mails|push)", "\\bkeeps? (sending|notifying|pinging|buzzing|spamming)\\b", "\\b(can'?t|cannot|no way to) (turn off|disable|mute|stop) (the )?(notifications|reminders|e-?mails)\\b",
                  "\\bte veel (meldingen|notificaties|herinneringen|e-?mails|mails|berichten)\\b", "\\b(irritante|constante|eindeloze) (meldingen|notificaties|herinneringen|e-?mails|mails)\\b", "\\b(meldingen|notificaties|herinneringen) (kan|kun) (je )?niet uit"]},
    {"id": "ads", "label": "Ads", "kind": "complaint",
     "patterns": ["\\bads\\b", "\\badvert", "\\bad.?supported\\b", "\\bpop.?ups?\\b",
                  "\\breclame\\b", "\\badvertenties\\b"]},
    {"id": "updates", "label": "A redesign or update made it worse", "kind": "complaint",
     "patterns": ["\\b(new|latest|recent) (update|version|design)\\b", "\\bredesign", "\\bused to be\\b", "\\bbring back\\b", "\\bsince the update\\b",
                  "\\bsinds de (laatste )?update\\b", "\\bnieuwe versie\\b"]},
    {"id": "privacy", "label": "Privacy and permissions", "kind": "complaint",
     "patterns": ["\\bprivacy\\b", "\\btracking\\b", "\\bsell(s|ing)? (my )?data\\b", "\\bpermissions?\\b", "\\bcreepy\\b",
                  "\\bgegevens (verkopen|delen)\\b"]},
    {"id": "integrations", "label": "Integrations, import and export", "kind": "request",
     "patterns": ["\\bintegrat", "\\bzapier\\b", "\\bgoogle (calendar|sheets|drive)\\b", "\\boutlook\\b", "\\bslack\\b", "\\bapi\\b", "\\bexport\\b", "\\bimport\\b", "\\bcsv\\b", "\\bwebhook",
                  "\\bkoppeling", "\\bkoppelen\\b", "\\bexporteren\\b", "\\bimporteren\\b", "\\bgoogle agenda\\b"]},
    {"id": "platforms", "label": "Platforms, offline and mobile", "kind": "request",
     "patterns": ["\\boffline\\b", "\\bandroid\\b", "\\bipad\\b", "\\btablet\\b", "\\bdesktop app\\b", "\\bmac app\\b", "\\bwindows\\b", "\\bmobile (app|version)\\b", "\\bweb version\\b",
                  "\\bzonder internet\\b"]},
    {"id": "customisation", "label": "Customisation and control", "kind": "request",
     "patterns": ["\\bcustomi[sz]", "\\bdark mode\\b", "\\btheme\\b", "\\bbranding\\b", "\\bwhite.?label\\b", "\\btemplates?\\b", "\\bmore (settings|options|control)\\b", "\\b(a )?setting (to|for)\\b", "\\boption to\\b",
                  "\\bmeer (instellingen|opties)\\b", "\\baanpassen\\b", "\\bdonkere modus\\b"]},
    {"id": "collaboration", "label": "Teams and sharing", "kind": "request",
     "patterns": ["\\bteammates?\\b", "\\bteam (features?|plans?|accounts?|members?|calendars?|access|workspace)\\b", "\\bfor teams\\b", "\\bshar(e|ing)\\b", "\\bcollaborat", "\\bmultiple (users|accounts|people)\\b", "\\b(user|team|admin) roles?\\b", "\\bpermissions for\\b",
                  "\\bdelen\\b", "\\bsamenwerk", "\\bcollega'?s\\b", "\\bteamleden\\b", "\\bmeerdere gebruikers\\b"]}
  ]
}
